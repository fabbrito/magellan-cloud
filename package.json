{
  "name": "magellan-cloud",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/githooks .githooks/commit-msg .githooks/pre-commit",
    "check": ".githooks/githooks check",
    "update": "bun update --latest -r -i && bun install",
    "check:fix": ".githooks/githooks check --fix",
    "format": "oxfmt",
    "lint": "oxlint --tsconfig ./tsconfig.base.json",
    "test": "vitest run",
    "typecheck": "bun run --filter '*' typecheck",
    "cf-typegen": "bun run --filter '*' cf-typegen",
    "dev": "bun run dev:migrate && bun --cwd=apps/ingest-worker run dev",
    "dev:migrate": "bun --cwd=apps/ingest-worker run dev:migrate",
    "dev:exec": "bun --cwd=apps/ingest-worker run dev:exec",
    "dev:reset": "bun --cwd=apps/ingest-worker run dev:reset",
    "db:generate": "bun --cwd=packages/db run db:generate",
    "mint": "bun --cwd=tools/mint-token run mint",
    "emit": "bun --cwd=tools/emit-openapi run emit",
    "live:deploy": "bun --cwd=apps/ingest-worker run live:deploy",
    "live:migrate": "bun --cwd=apps/ingest-worker run live:migrate",
    "live:exec": "bun --cwd=apps/ingest-worker run live:exec",
    "live:tail": "bun --cwd=apps/ingest-worker run live:tail"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24"
  }
}
