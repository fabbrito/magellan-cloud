{
  // The dashboard's tests: a DOM, like the client, and apart from the server's tests, whose workers
  // types clash with it.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
