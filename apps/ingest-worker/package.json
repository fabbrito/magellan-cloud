{
  "name": "@magellan/ingest-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./document": "./src/document.ts"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "dev:migrate": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/state",
    "dev:exec": "wrangler d1 execute DB --local --persist-to ../../.wrangler/state",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@magellan/contract": "workspace:*",
    "@magellan/db": "workspace:*",
    "@magellan/ingest": "workspace:*",
    "@magellan/token": "workspace:*",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@magellan/simulator": "workspace:*",
    "@types/node": "^26.6.3"
  }
}
