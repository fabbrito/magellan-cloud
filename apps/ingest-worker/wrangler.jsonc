{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "magellan-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magellan",
      // Local dev and tests key D1 by binding name; the maintainer pastes the
      // real id from `wrangler d1 create`.
      "database_id": "local",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "magellan-archive",
    },
  ],
}
