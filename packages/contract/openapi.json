{
  "openapi": "3.1.0",
  "info": {
    "title": "Magellan ingest",
    "version": "0"
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/devices/{id}/manifest": {
      "put": {
        "security": [
          {
            "deviceToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-bytes": 1999000,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tz": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$",
                    "description": "The device's IANA time zone, e.g. America/Sao_Paulo. Calendar days are cut in it."
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                        },
                        "metrics": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 64,
                                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                                  },
                                  "unit": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 16
                                  },
                                  "exponent": {
                                    "type": "integer",
                                    "minimum": -12,
                                    "maximum": 12,
                                    "description": "Decimal exponent of this metric's values: the value is scaled by 10^exponent."
                                  },
                                  "kind": {
                                    "type": "string",
                                    "enum": ["gauge"]
                                  }
                                },
                                "required": ["key", "exponent", "kind"],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 64,
                                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                                  },
                                  "unit": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 16
                                  },
                                  "exponent": {
                                    "type": "integer",
                                    "minimum": -12,
                                    "maximum": 12,
                                    "description": "Decimal exponent of this metric's values: the value is scaled by 10^exponent."
                                  },
                                  "kind": {
                                    "type": "string",
                                    "enum": ["counter"]
                                  },
                                  "resets": {
                                    "type": "string",
                                    "enum": ["daily"],
                                    "description": "The cadence this counter resets on. The boundary is not sent; a decrease marks it."
                                  }
                                },
                                "required": ["key", "exponent", "kind"],
                                "additionalProperties": false,
                                "description": "Monotonic between resets. Any decrease is a reset, declared or not: a restart or a wrap reads the same."
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 64,
                                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                                  },
                                  "kind": {
                                    "type": "string",
                                    "enum": ["state"]
                                  },
                                  "state_labels": {
                                    "type": "object",
                                    "additionalProperties": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 32
                                    },
                                    "maxProperties": 32,
                                    "propertyNames": {
                                      "type": "string",
                                      "pattern": "^\\d{1,9}$"
                                    },
                                    "description": "At most 32 labels, keyed by decimal codes of at most 9 digits."
                                  }
                                },
                                "required": ["key", "kind"],
                                "additionalProperties": false
                              }
                            ]
                          },
                          "minItems": 1,
                          "maxItems": 128,
                          "description": "One to 128 metrics, each key unique within the source."
                        }
                      },
                      "required": ["id", "metrics"],
                      "additionalProperties": false,
                      "description": "A named thing a device polls, and the metrics it declares."
                    },
                    "minItems": 1,
                    "maxItems": 8,
                    "description": "One to 8 sources, each id unique."
                  }
                },
                "required": ["tz", "sources"],
                "additionalProperties": false,
                "description": "A device's declaration of its sources and their metrics."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The manifest is stored.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "description": "The accepted manifest hash, quoted."
                },
                "required": true,
                "description": "The accepted manifest hash, quoted."
              }
            }
          },
          "400": {
            "description": "The body is not a manifest. A device must not retry it."
          },
          "401": {
            "description": "The credential is absent or resolves to no device."
          },
          "403": {
            "description": "The credential names another device."
          },
          "411": {
            "description": "No parseable `content-length`. A device must declare what it sends."
          },
          "413": {
            "description": "The body is past 1999000 bytes."
          },
          "429": {
            "description": "Too many requests. The device keeps the buffer."
          }
        }
      }
    },
    "/v1/devices/{id}/batches": {
      "post": {
        "security": [
          {
            "deviceToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-bytes": 6291456,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "manifest_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "boot_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8,32}$"
                  },
                  "seq": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d{0,19})$",
                    "description": "A counter, monotonic within one boot: canonical decimal, at most u64::MAX."
                  },
                  "readings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                        },
                        "ts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 32503680000000
                        },
                        "values": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991,
                            "description": "An integer; the physical value is this scaled by its metric's exponent."
                          },
                          "minProperties": 1,
                          "maxProperties": 128,
                          "description": "One to 128 metric values, keyed by metric key."
                        }
                      },
                      "required": ["source", "ts", "values"],
                      "additionalProperties": false,
                      "description": "One source poll: a UTC timestamp in ms and that source's metric values."
                    },
                    "minItems": 1,
                    "maxItems": 512
                  }
                },
                "required": ["manifest_hash", "boot_id", "seq", "readings"],
                "additionalProperties": false,
                "description": "One upload: ordered readings under a manifest hash, identified by boot_id and seq. A duplicate is absorbed per reading, not per batch."
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Committed, or already present."
          },
          "400": {
            "description": "The body is not a batch. A device must not retry it."
          },
          "401": {
            "description": "The credential is absent or resolves to no device."
          },
          "403": {
            "description": "The credential names another device."
          },
          "411": {
            "description": "No parseable `content-length`. A device must declare what it sends."
          },
          "413": {
            "description": "The body is past 6291456 bytes."
          },
          "422": {
            "description": "A reading names what the manifest does not declare."
          },
          "429": {
            "description": "Too many requests. The device keeps the buffer."
          },
          "503": {
            "description": "The named manifest has not arrived. The device keeps the buffer."
          }
        }
      }
    },
    "/v1/devices/{id}/heartbeats": {
      "post": {
        "security": [
          {
            "deviceToken": []
          }
        ],
        "description": "Fire and forget: a device treats any 2xx as stored and ignores every other answer, never retrying or buffering one. The next heartbeat supersedes it.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-bytes": 4096,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "boot_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8,32}$"
                  },
                  "uptime_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 315576000
                  },
                  "buffer_depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Batches pending on the device when sent."
                  },
                  "battery_percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "signal_percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "firmware_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "sources_last_heard": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32503680000000
                    },
                    "maxProperties": 8,
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                    },
                    "description": "When the device last heard each source, UTC ms, keyed by source id. At most 8; a source not heard since boot is absent."
                  }
                },
                "required": ["boot_id", "uptime_seconds", "buffer_depth", "sources_last_heard"],
                "additionalProperties": false,
                "description": "The device's account of itself, sent on its own cadence."
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Stored."
          },
          "400": {
            "description": "The body is not a heartbeat."
          },
          "401": {
            "description": "The credential is absent or resolves to no device."
          },
          "403": {
            "description": "The credential names another device."
          },
          "411": {
            "description": "No parseable `content-length`. A device must declare what it sends."
          },
          "413": {
            "description": "The body is past 4096 bytes."
          },
          "429": {
            "description": "Too many requests."
          }
        }
      }
    }
  },
  "webhooks": {}
}
