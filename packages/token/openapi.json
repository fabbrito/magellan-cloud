                    },
                    "status": {
                      "type": "integer"
                    },
                    "title": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "status", "title"],
                  "description": "RFC 9457. A client branches on the status, never the text."
                }
              }
            }
          },
          "409": {
            "description": "The id is taken, revoked or not.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
