                            "type": "object",
                            "additionalProperties": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 32
                            },
                            "maxProperties": 32,
                            "propertyNames": {
                              "type": "string",
                              "pattern": "^\\d{1,9}$"
                            },
                            "description": "At most 32 labels, keyed by decimal codes of at most 9 digits."
