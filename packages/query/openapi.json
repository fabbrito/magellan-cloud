                            "description": "The cadence this counter resets on. The boundary is not sent; a decrease marks it."
                          },
                          "source": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                          },
                          "metric": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
