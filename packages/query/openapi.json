{
  "openapi": "3.1.0",
  "info": {
    "title": "Magellan read",
    "version": "0"
  },
  "components": {
    "securitySchemes": {
      "clientToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/devices": {
      "get": {
        "security": [
          {
            "clientToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Every device, revoked ones too.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                      },
                      "description": {
                        "type": "string"
                      },
                      "revoked_at": {
                        "type": ["string", "null"],
                        "format": "date-time",
                        "description": "Revoked, still read: the device keeps its history."
                      }
                    },
                    "required": ["id", "description", "revoked_at"]
                  }
                }
              }
            }
          },
          "401": {
            "description": "No client token, or one revoked.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["about:blank"]
                    },
                    "status": {
                      "type": "integer"
                    },
                    "title": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "status", "title"],
                  "description": "RFC 9457. A client branches on the status, never the text."
                }
              }
            }
          }
        }
      }
    },
