# Copy to cloudflare.prod.env, which git ignores. Read by make's Tokens targets:
# KEY=value, no quotes.
# Prints a Cloudflare API token on stdout, e.g. pass show cloudflare/magellan-d1.
# Account-scoped, D1 Edit and nothing else: the targets only run statements on
# the live D1. Never the deploy's token, which lives in CI alone.
CLOUDFLARE_TOKEN_CMD=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
